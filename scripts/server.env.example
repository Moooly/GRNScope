# Copy this file to ../server.env and edit it before installation.
# Use absolute paths without spaces. No shell expansion is performed.
DATA_ROOT=/data2/platform/grnscope
DATA_MOUNT=/data2
CONDA_EXE=/apps/software/Miniconda3/4.9.2/bin/conda
NODE_BIN=/home/platform/.nvm/versions/node/v20.18.0/bin

# Beeline defaults to the checkout beside GRNScope. Override only if needed.
# BEELINE_ROOT=/home/platform/project/grnscope/Beeline

# Reserve unused ports and this service prefix with the server administrator.
SERVICE_PREFIX=grnscope
FRONTEND_PORT=13000
BACKEND_PORT=18000
REDIS_PORT=16379

# Starting allocation for a shared server: per-algorithm CPU and memory limits.
WORKER_COUNT=2
ALGORITHM_CPU_BUDGET=8
ALGORITHM_MEMORY_MB=32768
PUBLIC_URL=https://grnscope.example.edu
