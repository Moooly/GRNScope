# Copy to server.env in the GRNScope checkout and edit these five settings.
# Uploads, results and generated files go here, outside the code checkout.
# On the Hong Kong server, use /data2/platform/grnscope instead.
DATA_ROOT=~/grnscope-data
# The public website address; DNS and Apache are configured separately.
PUBLIC_URL=https://grnscope.example.edu

# Set the installed tool paths explicitly. These are examples, not auto-detected.
CONDA_EXE=~/miniconda3/bin/conda
NODE_BIN=/usr/bin
BEELINE_ROOT=~/gene_website/Beeline

# Ports and resource limits are optional. See DEPLOYMENT.md for overrides.
